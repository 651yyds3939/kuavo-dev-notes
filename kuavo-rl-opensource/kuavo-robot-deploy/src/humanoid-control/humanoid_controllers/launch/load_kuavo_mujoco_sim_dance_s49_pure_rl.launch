<?xml version="1.0" ?>
<!-- S49 dance: pure RL joint PD (Isaac-like), no WBC tracking blend.
     MuJoCo applies precomputed tau from updateRLcmd (kp/kd in controller, not in mujoco_node).
     Expect kneel/jump like training; may fall — that is the sim2sim test.
     Usage:
       roslaunch humanoid_controllers load_kuavo_mujoco_sim_dance_s49_pure_rl.launch joystick_type:=sim
     Auto-start RL after WBC settle, with an equivalent PD seed action computed from
     the final WBC torque and blended into the policy over sim_rl_seed_blend_sec.
     Set sim_rl_debug_hold_seed_action:=true to hold that seed indefinitely and
     validate the no-WBC PD equilibrium before enabling the policy. -->
<launch>
    <arg name="joystick_type" default="sim"/>
    <arg name="rl_from_start" default="true"/>
    <arg name="sim_rl_debug_zero_action" default="false"/>
    <arg name="sim_rl_debug_hold_seed_action" default="false"/>
    <arg name="sim_rl_use_wbc_seed" default="true"/>
    <arg name="sim_rl_seed_blend_sec" default="2.0"/>
    <arg name="sim_rl_spawn_pitch_rad" default="0.0"/>
    <include file="$(find humanoid_controllers)/launch/load_kuavo_mujoco_sim_dance_s49.launch">
        <arg name="joystick_type" value="$(arg joystick_type)"/>
        <arg name="rl_from_start" value="$(arg rl_from_start)"/>
        <arg name="sim_keep_wbc_with_rl" value="false"/>
        <arg name="sim_rl_debug_zero_action" value="$(arg sim_rl_debug_zero_action)"/>
        <arg name="sim_rl_debug_hold_seed_action" value="$(arg sim_rl_debug_hold_seed_action)"/>
        <arg name="sim_rl_use_wbc_seed" value="$(arg sim_rl_use_wbc_seed)"/>
        <arg name="sim_rl_seed_blend_sec" value="$(arg sim_rl_seed_blend_sec)"/>
        <arg name="sim_rl_spawn_pitch_rad" value="$(arg sim_rl_spawn_pitch_rad)"/>
    </include>
</launch>
